{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug Bun",
      "program": "${workspaceFolder}/src/index.ts",
      "args": [
        "-r",
        "example/referral.rules.yaml",
        "-o",
        "example/output.json",
        "-p",
        "example/report.html",
        "example/referrals.csv",
        "example/referrals_missingfields.csv",
        "example/referrals_missingreqd.csv",
        "example/referrals.json"
      ],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "watchMode": false
    }
  ]
}